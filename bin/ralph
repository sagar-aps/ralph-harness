#!/usr/bin/env node
const { spawnSync } = require("child_process");
const fs = require("fs");
const os = require("os");
const path = require("path");

const rawArgs = process.argv.slice(2);
const args = [];
const cwd = process.cwd();
const repoRoot = path.resolve(__dirname, "..");
const globalDir = path.join(repoRoot, ".agents", "ralph");
const localDir = path.join(cwd, ".agents", "ralph");
const skillsRoot = path.join(repoRoot, "skills");
let agentOverride = null;
let installSkills = false;
let installForce = false;
let prdPath = null;
let progressPath = null;
let prdOutPath = null;
// Review-loop (builder/reviewer) + operator options.
const review = {
  repo: null,
  builder: null,
  reviewer: null,
  maxIterations: null,
  check: null,
  task: null,
  taskIndex: null,
  branch: null,
  verdictRegex: null,
  allowDirty: false,
  noWorktree: false,
  // preview / website validation
  appPort: null,
  dbPort: null,
  previewHost: null,
  preview: null, // null = use target config; true/false = forced
  keepPreviewOnFail: false,
  // init-target / operator commands
  type: null,
  run: null,
  cleanup: false,
  skipCleanup: false,
  deleteBranch: false,
  // batch mode
  plan: null,
  maxTasks: null,
  autoApproveBuilder: false,
  stopOnFail: false,
  // preflight (repo contract)
  skipPreflight: false,
};

function exists(p) {
  try {
    fs.accessSync(p);
    return true;
  } catch {
    return false;
  }
}

// Load the interactive-prompt dependency, auto-installing it the first time if it
// is missing (it ships as a declared dependency, but a freshly linked clone may
// not have run `npm install` yet). Falls back to a clear instruction if that fails.
async function loadPrompts() {
  try {
    return await import("@clack/prompts");
  } catch (err) {
    if (!err || err.code !== "ERR_MODULE_NOT_FOUND") throw err;
    console.error("Ralph needs its '@clack/prompts' dependency, which isn't installed yet.");
    console.error(`Installing it now (npm install in ${repoRoot})...`);
    const result = spawnSync("npm", ["install", "--no-audit", "--no-fund"], {
      cwd: repoRoot,
      stdio: "inherit",
    });
    if (result.status === 0) {
      try {
        return await import("@clack/prompts");
      } catch {
        /* fall through to manual instructions */
      }
    }
    console.error("\nCould not load '@clack/prompts'. Install dependencies, then retry:");
    console.error(`  ( cd ${repoRoot} && npm install )`);
    process.exit(1);
  }
}

// --- Operator-command helpers (status / integrate / cleanup) ----------------
function git(repo, gitArgs, opts = {}) {
  return spawnSync("git", ["-C", repo, ...gitArgs], { encoding: "utf-8", ...opts });
}

function parseEnvFile(file) {
  const out = {};
  if (!exists(file)) return out;
  for (const line of fs.readFileSync(file, "utf-8").split("\n")) {
    const trimmed = line.trim();
    if (!trimmed || trimmed.startsWith("#")) continue;
    const idx = trimmed.indexOf("=");
    if (idx === -1) continue;
    out[trimmed.slice(0, idx)] = trimmed.slice(idx + 1);
  }
  return out;
}

function readTargetConfig(repo) {
  const file = path.join(repo, "ralph.target.json");
  if (!exists(file)) return {};
  try {
    return JSON.parse(fs.readFileSync(file, "utf-8"));
  } catch {
    return {};
  }
}

// Resolve a run directory from --run latest|<run-id>, falling back to last-run.env.
function resolveRun(repo, runArg) {
  const runsDir = path.join(repo, ".ralph", "runs");
  const lastRun = parseEnvFile(path.join(repo, ".ralph", "last-run.env"));
  // The artifacts dir from last-run.env may live outside .ralph/runs (e.g. batch
  // runs use .agent-run/batch-<ts>/), so prefer it when it matches the run id.
  const dirForLastRun = () =>
    lastRun.ARTIFACTS_DIR && exists(lastRun.ARTIFACTS_DIR)
      ? lastRun.ARTIFACTS_DIR
      : path.join(runsDir, lastRun.RUN_ID || "");
  if (!runArg || runArg === "latest") {
    if (lastRun.RUN_ID) {
      const rd = dirForLastRun();
      return { runId: lastRun.RUN_ID, runDir: exists(rd) ? rd : null, lastRun };
    }
    // Fallback: newest directory by name under .ralph/runs.
    if (exists(runsDir)) {
      const dirs = fs
        .readdirSync(runsDir)
        .filter((d) => fs.statSync(path.join(runsDir, d)).isDirectory())
        .sort();
      if (dirs.length) {
        const runId = dirs[dirs.length - 1];
        return { runId, runDir: path.join(runsDir, runId), lastRun };
      }
    }
    return { runId: null, runDir: null, lastRun };
  }
  if (runArg === lastRun.RUN_ID) {
    const rd = dirForLastRun();
    return { runId: runArg, runDir: exists(rd) ? rd : null, lastRun };
  }
  return { runId: runArg, runDir: path.join(runsDir, runArg), lastRun: {} };
}

// Merge last-run.env with the chosen run's final_status.md / config.resolved.env.
function loadRunMeta(repo, runArg) {
  const { runId, runDir, lastRun } = resolveRun(repo, runArg);
  let meta = { ...lastRun };
  if (runDir && exists(path.join(runDir, "config.resolved.env"))) {
    const cfg = parseEnvFile(path.join(runDir, "config.resolved.env"));
    // last-run.env wins for STATUS/PREVIEW_URL; config fills the rest.
    meta = { ...cfg, ...meta };
  }
  if (runId && !meta.RUN_ID) meta.RUN_ID = runId;
  if (runDir && !meta.ARTIFACTS_DIR) meta.ARTIFACTS_DIR = runDir;
  return { runId, runDir, meta };
}

// Shared by `cleanup` and the default cleanup that `integrate` runs on success.
// Conservative by design: refuses a dirty worktree without force; keeps the branch.
function doCleanup(repo, runId, meta, deleteBranch, force) {
  const actions = [];
  const left = [];
  const cfg = readTargetConfig(repo);
  const worktree = meta.WORKTREE;

  // Stop the preview if a down script/config exists.
  if (cfg.preview && cfg.preview.enabled && cfg.preview.down) {
    const runIn = worktree && exists(worktree) ? worktree : repo;
    const composeProject =
      meta.RALPH_COMPOSE_PROJECT ||
      `ralph-${String(runId).toLowerCase().replace(/[^a-z0-9]/g, "-")}`;
    const env = {
      ...process.env,
      RALPH_RUN_ID: runId,
      RALPH_COMPOSE_PROJECT: composeProject,
      RALPH_TARGET_REPO: repo,
      RALPH_WORKTREE: runIn,
      RALPH_APP_PORT: meta.RALPH_APP_PORT || "",
      RALPH_DB_PORT: meta.RALPH_DB_PORT || "",
    };
    const r = spawnSync("bash", ["-lc", cfg.preview.down], { cwd: runIn, env, stdio: "inherit" });
    actions.push(`ran preview-down (${cfg.preview.down}) -> exit ${r.status ?? "?"}`);
  }

  // Remove the worktree (refuse if dirty unless --force).
  if (worktree && worktree !== repo && exists(worktree)) {
    const wtDirty = git(worktree, ["status", "--porcelain"])
      .stdout.split("\n")
      .filter((l) => l && !/\.ralph\//.test(l) && !/\.agent-handoff\.md/.test(l));
    if (wtDirty.length && !force) {
      left.push(
        `worktree ${worktree} has uncommitted changes — not removed (use --force):\n    ${wtDirty
          .join("\n    ")}`,
      );
    } else {
      const args = ["worktree", "remove", worktree];
      if (force) args.push("--force");
      const r = git(repo, args);
      if (r.status === 0) actions.push(`removed worktree ${worktree}`);
      else left.push(`failed to remove worktree ${worktree}: ${(r.stderr || "").trim()}`);
    }
    git(repo, ["worktree", "prune"]);
  } else if (worktree && worktree === repo) {
    left.push("run used an in-place branch (no separate worktree to remove)");
  } else {
    actions.push(`no worktree to remove (${worktree || "none recorded"})`);
  }

  // Branch: keep by default.
  const branch = meta.BRANCH;
  if (branch) {
    if (deleteBranch) {
      const r = git(repo, ["branch", "-D", branch]);
      if (r.status === 0) actions.push(`deleted branch ${branch}`);
      else left.push(`could not delete branch ${branch}: ${(r.stderr || "").trim()}`);
    } else {
      left.push(`branch ${branch} kept (use --delete-branch to remove it)`);
    }
  }

  console.log(`Cleanup for run ${runId} (${repo}):`);
  for (const a of actions) console.log(`  ✔ ${a}`);
  for (const l of left) console.log(`  • ${l}`);
  if (!actions.length && !left.length) console.log("  (nothing to do)");
  return 0;
}

function readPackageMeta() {
  try {
    const pkgPath = path.join(repoRoot, "package.json");
    const data = JSON.parse(fs.readFileSync(pkgPath, "utf-8"));
    return { name: data.name || "ralph", version: data.version || "0.0.0" };
  } catch {
    return { name: "ralph", version: "0.0.0" };
  }
}

function compareVersions(a, b) {
  const parse = (value) =>
    String(value || "")
      .split(".")
      .map((part) => parseInt(part, 10))
      .map((n) => (Number.isNaN(n) ? 0 : n));
  const pa = parse(a);
  const pb = parse(b);
  const len = Math.max(pa.length, pb.length);
  for (let i = 0; i < len; i += 1) {
    const da = pa[i] || 0;
    const db = pb[i] || 0;
    if (da > db) return 1;
    if (da < db) return -1;
  }
  return 0;
}

function checkForUpdate() {
  if (!process.stdout.isTTY || !process.stdin.isTTY) return null;
  if (process.env.RALPH_SKIP_UPDATE_CHECK === "1") return null;
  const { name, version } = readPackageMeta();
  const result = spawnSync("npm", ["view", name, "version"], { encoding: "utf-8" });
  if (result.status !== 0) return null;
  const latest = String(result.stdout || "").trim();
  if (!latest) return null;
  if (compareVersions(latest, version) <= 0) return null;
  return { name, current: version, latest };
}

function usage() {
  console.log(`ralph <command>

Commands:
  install [--skills] [--force]        Copy .agents/ralph into the current repo
  prd ["<request>"] [--out path]      Generate a PRD (JSON) via agent
  ping                                Minimal agent health check
  log "<message>"                     Append to .ralph/activity.log
  build [n] [--no-commit]             Run single-agent build loop (default)
  review [task] --repo <path>         Run builder/reviewer loop on a TARGET repo
  batch --repo <path> --plan <p>      Run many tasks sequentially in ONE worktree
  preflight --repo <path>             Run the repo-contract preflight only
  status --repo <path>                Show the latest run's status
  integrate --repo <path> [--run]     Merge an approved run, re-check, then auto-cleanup
  cleanup --repo <path> [--run]       Remove a run's worktree / stop its preview
  init-target --repo <path> [--type]  Scaffold a target repo (generic|nextjs-postgres)
  install-agent-commands [--agent X]  Install operator commands (claude|codex|copilot)
  overview                            Render a human overview from PRD JSON
  help                                Show this message

Options:
  --prd <path>                        Override PRD path
  --out <path>                        Override PRD output path (prd command)
  --progress <path>                   Override progress log path
  --agent <codex|claude|droid|opencode>  Override agent runner

Review-loop options (also enabled by passing --repo/--reviewer to build):
  --repo <path>                       Target repo to operate on (required)
  --builder <backend>                 Backend for the builder role (default: opencode)
  --reviewer <backend>                Backend for the reviewer role (default: claude)
  --max-iterations <n>                Max builder/reviewer cycles (default: 5)
  --check <cmd>                       Check command in target (default: ./scripts/check.sh)
  --task <id> | review <index>        Select a PRD story by id or 1-based index
  --branch <name>                     Override the working branch name
  --allow-dirty                       Allow a dirty target working tree
  --no-worktree                       Branch in place instead of a git worktree
  --verdict-regex <re>                Reviewer verdict regex (default: '^VERDICT: (PASS|FAIL)')
  --preview | --no-preview            Force website preview+e2e on/off (else target config)
  --app-port <n> / --db-port <n>      Fixed preview ports (else auto-allocated)
  --preview-host <host>               Hostname for the preview URL (default: localhost)
  --keep-preview-on-fail              Leave the preview running after a failed run
  --run latest|<run-id>               Select a run for status/integrate/cleanup
  --force                             integrate non-ready / overwrite on install / force cleanup
  --delete-branch                     also delete the run branch (cleanup/integrate)
  --keep-worktree | --skip-cleanup    integrate: don't auto-clean up afterwards
  --type generic|nextjs-postgres      init-target scaffold type

Batch options (ralph batch):
  --plan <dir|file>                   Tasks: a dir of *.md (sorted) or one .md split by heading
  --max-tasks <n>                     Cap how many tasks run (default: all)
  --auto-approve-builder              Builder runs unattended (permission-skipping); reviewer stays read-only
  --stop-on-fail                      Stop at the first failing task

Preflight options (build / review / batch / preflight):
  --no-preflight | --skip-preflight   Skip the repo-contract preflight phase
  (configure steps under "preflight" in the target's ralph.target.json)

Notes:
- Uses local .agents/ralph if present; otherwise uses bundled defaults.
- State and logs are written to .ralph/ in the project.
- The review loop never merges to main; it stops at READY_FOR_HUMAN_REVIEW.
- Backends: claude, codex, droid, opencode, opencode-z, codex-write, codex-readonly,
  or any custom AGENT_<NAME>_CMD defined in agents.sh/review-config.sh.
`);
}

function findPrdCandidates(baseDir) {
  const tasksDir = path.join(baseDir, ".agents", "tasks");
  if (!exists(tasksDir)) {
    return [];
  }
  return fs
    .readdirSync(tasksDir)
    .filter((name) => name.toLowerCase().endsWith(".json"))
    .map((name) => path.join(tasksDir, name));
}

function defaultPrdOutputPath(baseDir, request) {
  return path.join(baseDir, ".agents", "tasks");
}

async function resolvePrdPath({ cwd, explicitPath, label }) {
  if (explicitPath) {
    return path.resolve(cwd, explicitPath);
  }
  const candidates = findPrdCandidates(cwd);
  if (candidates.length === 0) {
    return null;
  }
  if (candidates.length === 1) {
    return candidates[0];
  }
  const { intro, select, outro, isCancel } = await loadPrompts();
  intro(label || "Select PRD");
  const selection = await select({
    message: "Pick a PRD JSON file",
    options: candidates.map((file) => ({
      value: file,
      label: path.relative(cwd, file),
    })),
  });
  if (isCancel(selection)) {
    outro("Cancelled.");
    process.exit(0);
  }
  outro("Selected.");
  return selection;
}

for (let i = 0; i < rawArgs.length; i += 1) {
  const arg = rawArgs[i];
  if (arg.startsWith("--agent=")) {
    agentOverride = arg.split("=").slice(1).join("=");
    continue;
  }
  if (arg === "--agent") {
    agentOverride = rawArgs[i + 1];
    i += 1;
    continue;
  }
  if (arg === "--skills") {
    installSkills = true;
    continue;
  }
  if (arg === "--force") {
    installForce = true;
    continue;
  }
  if (arg.startsWith("--prd=")) {
    prdPath = arg.split("=").slice(1).join("=");
    continue;
  }
  if (arg.startsWith("--out=")) {
    prdOutPath = arg.split("=").slice(1).join("=");
    continue;
  }
  if (arg === "--prd") {
    prdPath = rawArgs[i + 1];
    i += 1;
    continue;
  }
  if (arg === "--out") {
    prdOutPath = rawArgs[i + 1];
    i += 1;
    continue;
  }
  if (arg.startsWith("--progress=")) {
    progressPath = arg.split("=").slice(1).join("=");
    continue;
  }
  if (arg === "--progress") {
    progressPath = rawArgs[i + 1];
    i += 1;
    continue;
  }
  // --- Review loop flags (--flag value and --flag=value forms) ---
  const reviewFlags = {
    "--repo": "repo",
    "--builder": "builder",
    "--reviewer": "reviewer",
    "--max-iterations": "maxIterations",
    "--check": "check",
    "--task": "task",
    "--branch": "branch",
    "--verdict-regex": "verdictRegex",
    "--app-port": "appPort",
    "--db-port": "dbPort",
    "--preview-host": "previewHost",
    "--type": "type",
    "--run": "run",
    "--plan": "plan",
    "--max-tasks": "maxTasks",
  };
  let matchedReviewFlag = false;
  for (const [flag, key] of Object.entries(reviewFlags)) {
    if (arg === flag) {
      review[key] = rawArgs[i + 1];
      i += 1;
      matchedReviewFlag = true;
      break;
    }
    if (arg.startsWith(`${flag}=`)) {
      review[key] = arg.slice(flag.length + 1);
      matchedReviewFlag = true;
      break;
    }
  }
  if (matchedReviewFlag) continue;
  if (arg === "--allow-dirty") {
    review.allowDirty = true;
    continue;
  }
  if (arg === "--no-worktree") {
    review.noWorktree = true;
    continue;
  }
  if (arg === "--preview") {
    review.preview = true;
    continue;
  }
  if (arg === "--no-preview") {
    review.preview = false;
    continue;
  }
  if (arg === "--keep-preview-on-fail") {
    review.keepPreviewOnFail = true;
    continue;
  }
  if (arg === "--cleanup") {
    review.cleanup = true;
    continue;
  }
  if (arg === "--keep-worktree" || arg === "--skip-cleanup") {
    review.skipCleanup = true;
    continue;
  }
  if (arg === "--delete-branch") {
    review.deleteBranch = true;
    continue;
  }
  if (arg === "--auto-approve-builder") {
    review.autoApproveBuilder = true;
    continue;
  }
  if (arg === "--stop-on-fail") {
    review.stopOnFail = true;
    continue;
  }
  if (arg === "--no-preflight" || arg === "--skip-preflight") {
    review.skipPreflight = true;
    continue;
  }
  args.push(arg);
}

const cmd = args[0];
if (cmd === "help" || cmd === "-h" || cmd === "--help") {
  usage();
  process.exit(0);
}

async function runInstallSkills() {
  const { intro, outro, select, isCancel } = await loadPrompts();
  intro("Ralph skills install");

  const agent = await select({
    message: "Which agent are you using?",
    options: [
      { value: "codex", label: "codex" },
      { value: "claude", label: "claude" },
      { value: "droid", label: "droid" },
      { value: "opencode", label: "opencode" },
    ],
    initialValue: agentOverride || "codex",
  });
  if (isCancel(agent)) {
    outro("Cancelled.");
    process.exit(0);
  }

  const scope = await select({
    message: "Where should skills be installed?",
    options: [
      { value: "local", label: "Local (project)" },
      { value: "global", label: "Global (home directory)" },
    ],
    initialValue: "local",
  });
  if (isCancel(scope)) {
    outro("Cancelled.");
    process.exit(0);
  }

  const home = os.homedir();
  const targetRoot =
    agent === "codex"
      ? scope === "global"
        ? path.join(home, ".codex", "skills")
        : path.join(cwd, ".codex", "skills")
      : agent === "claude"
        ? scope === "global"
          ? path.join(home, ".claude", "skills")
          : path.join(cwd, ".claude", "skills")
        : agent === "droid"
          ? scope === "global"
            ? path.join(home, ".factory", "skills")
            : path.join(cwd, ".factory", "skills")
          : scope === "global"
            ? path.join(home, ".local", "share", "opencode", "skills")
            : path.join(cwd, ".opencode", "skills");

  const skillsToInstall = ["commit", "dev-browser", "prd"];
  fs.mkdirSync(targetRoot, { recursive: true });
  const installed = [];
  const skipped = [];

  for (const skill of skillsToInstall) {
    const source = path.join(skillsRoot, skill);
    const target = path.join(targetRoot, skill);
    if (!exists(source)) {
      skipped.push(`${skill} (missing in repo)`);
      continue;
    }
    if (exists(target) && !installForce) {
      skipped.push(`${skill} (already exists)`);
      continue;
    }
    fs.cpSync(source, target, { recursive: true, force: true });
    installed.push(skill);
  }

  if (installed.length) {
    console.log(`Installed skills to ${targetRoot}: ${installed.join(", ")}`);
  }
  if (skipped.length) {
    console.log(`Skipped: ${skipped.join(", ")}`);
  }
  outro("Done.");
}

async function main() {
  const updateInfo = checkForUpdate();
  if (updateInfo) {
    const { intro, confirm, outro, isCancel } = await loadPrompts();
    intro("Ralph update available");
    const shouldUpdate = await confirm({
      message: `Update ${updateInfo.name} from ${updateInfo.current} to ${updateInfo.latest}?`,
      initialValue: true,
    });
    if (isCancel(shouldUpdate)) {
      outro("Skipped update.");
    } else if (shouldUpdate) {
      outro("Updating...");
      const result = spawnSync("npm", ["i", "-g", `${updateInfo.name}@latest`], {
        stdio: "inherit",
      });
      process.exit(result.status ?? 1);
    } else {
      outro("Skipped update.");
    }
  }

  // --- Review loop (builder/reviewer) routing ---------------------------------
  const reviewTriggered =
    cmd === "review" ||
    ((cmd === "build" || !cmd) &&
      (review.repo || review.reviewer || review.builder || process.env.TARGET_REPO));
  if (reviewTriggered) {
    const templateDir = exists(localDir) ? localDir : globalDir;
    const reviewLoop = path.join(templateDir, "review-loop.sh");
    if (!exists(reviewLoop)) {
      console.error(`review-loop.sh not found at ${reviewLoop}`);
      process.exit(1);
    }
    // First bare integer positional (after the command word) = task index.
    const positionals = args.slice(1).filter((a) => /^[0-9]+$/.test(a));
    if (positionals.length && !review.task) {
      review.taskIndex = positionals[0];
    }
    const targetRepo = review.repo || process.env.TARGET_REPO;
    if (!targetRepo) {
      console.error("A target repo is required. Pass --repo <path> or set TARGET_REPO.");
      process.exit(1);
    }
    const env = { ...process.env };
    env.TARGET_REPO = path.resolve(cwd, targetRepo);
    if (review.builder || process.env.BUILDER) env.BUILDER = review.builder || process.env.BUILDER;
    if (review.reviewer || process.env.REVIEWER) env.REVIEWER = review.reviewer || process.env.REVIEWER;
    if (review.maxIterations) env.MAX_ITERATIONS = review.maxIterations;
    if (review.check) env.CHECK_CMD = review.check;
    if (review.task) env.TASK_ID = review.task;
    if (review.taskIndex) env.TASK_INDEX = review.taskIndex;
    if (review.branch) env.BRANCH = review.branch;
    if (review.verdictRegex) env.VERDICT_REGEX = review.verdictRegex;
    if (prdPath) env.PRD_PATH = path.resolve(cwd, prdPath);
    if (review.allowDirty) env.ALLOW_DIRTY = "true";
    if (review.skipPreflight) env.PREFLIGHT_SKIP = "true";
    if (review.noWorktree) env.USE_WORKTREE = "false";
    // Preview / website validation
    if (review.preview === true) env.PREVIEW_ENABLED = "true";
    if (review.preview === false) env.PREVIEW_ENABLED = "false";
    if (review.appPort) env.RALPH_APP_PORT = review.appPort;
    if (review.dbPort) env.RALPH_DB_PORT = review.dbPort;
    if (review.previewHost) env.PREVIEW_HOST = review.previewHost;
    if (review.keepPreviewOnFail) env.KEEP_ON_FAIL = "true";
    const result = spawnSync(reviewLoop, [], { stdio: "inherit", env });
    process.exit(result.status ?? 1);
  }

  // --- Batch mode: many tasks, ONE shared worktree ----------------------------
  if (cmd === "batch") {
    const templateDir = exists(localDir) ? localDir : globalDir;
    const batchLoop = path.join(templateDir, "batch-loop.sh");
    if (!exists(batchLoop)) {
      console.error(`batch-loop.sh not found at ${batchLoop}`);
      process.exit(1);
    }
    const targetRepo = review.repo || process.env.TARGET_REPO;
    if (!targetRepo) {
      console.error("ralph batch requires a target repo. Pass --repo <path> or set TARGET_REPO.");
      process.exit(1);
    }
    const plan = review.plan || process.env.PLAN;
    if (!plan) {
      console.error("ralph batch requires a plan. Pass --plan <dir-or-file>.");
      process.exit(1);
    }
    const env = { ...process.env };
    env.TARGET_REPO = path.resolve(cwd, targetRepo);
    env.PLAN = path.resolve(cwd, plan);
    if (review.builder || process.env.BUILDER) env.BUILDER = review.builder || process.env.BUILDER;
    if (review.reviewer || process.env.REVIEWER) env.REVIEWER = review.reviewer || process.env.REVIEWER;
    if (review.check) env.CHECK_CMD = review.check;
    if (review.maxTasks) env.MAX_TASKS = review.maxTasks;
    if (review.branch) env.BRANCH = review.branch;
    if (review.verdictRegex) env.VERDICT_REGEX = review.verdictRegex;
    if (review.allowDirty) env.ALLOW_DIRTY = "true";
    if (review.skipPreflight) env.PREFLIGHT_SKIP = "true";
    if (review.autoApproveBuilder) env.AUTO_APPROVE_BUILDER = "true";
    if (review.stopOnFail) env.STOP_ON_FAIL = "true";
    // End-of-batch website preview (same knobs as `ralph review`).
    if (review.preview === true) env.PREVIEW_ENABLED = "true";
    if (review.preview === false) env.PREVIEW_ENABLED = "false";
    if (review.appPort) env.RALPH_APP_PORT = review.appPort;
    if (review.dbPort) env.RALPH_DB_PORT = review.dbPort;
    if (review.previewHost) env.PREVIEW_HOST = review.previewHost;
    const result = spawnSync(batchLoop, [], { stdio: "inherit", env });
    process.exit(result.status ?? 1);
  }

  // --- Preflight (repo contract) as a standalone phase ------------------------
  if (cmd === "preflight") {
    const targetRepo = review.repo || process.env.TARGET_REPO || cwd;
    const repo = path.resolve(cwd, targetRepo);
    if (!exists(repo)) {
      console.error(`Repo not found: ${repo}`);
      process.exit(1);
    }
    const templateDir = exists(localDir) ? localDir : globalDir;
    const pf = path.join(templateDir, "preflight.sh");
    if (!exists(pf)) {
      console.error(`preflight.sh not found at ${pf}`);
      process.exit(1);
    }
    const env = { ...process.env };
    if (review.skipPreflight) env.PREFLIGHT_SKIP = "true";
    const report = path.join(repo, ".ralph", `preflight-${Date.now()}.md`);
    const result = spawnSync("bash", [pf, repo, report], { stdio: "inherit", env });
    process.exit(result.status ?? 1);
  }

  // --- Install operator commands into a coding agent (v1: Claude Code) --------
  if (cmd === "install-agent-commands") {
    // Operator commands are authored once (canonical, Claude-flavored markdown in
    // agent-commands/ralph/) and adapted per agent at install time. To add a new
    // agent, add an entry to AGENT_TARGETS below — the menu and installer pick it
    // up automatically. Locations verified against each tool's docs (May 2026):
    //   Claude Code     ~/.claude/commands/<name>.md            (slash commands)
    //   Codex CLI       ~/.codex/prompts/<name>.md              (slash commands)
    //   GitHub Copilot  <VS Code user>/prompts/<name>.prompt.md (VS Code chat)
    const home = os.homedir();
    const copilotUserPromptsDir = () => {
      if (process.platform === "darwin")
        return path.join(home, "Library", "Application Support", "Code", "User", "prompts");
      if (process.platform === "win32")
        return path.join(process.env.APPDATA || path.join(home, "AppData", "Roaming"), "Code", "User", "prompts");
      return path.join(home, ".config", "Code", "User", "prompts");
    };
    const stripFrontmatter = (s) => s.replace(/^---\n[\s\S]*?\n---\n+/, "");
    const frontmatterField = (s, key) => {
      const m = s.match(new RegExp(`^---\\n[\\s\\S]*?^${key}:\\s*(.+)$[\\s\\S]*?\\n---`, "m"));
      return m ? m[1].trim() : "";
    };
    const toCopilotPrompt = (s) => {
      const desc = frontmatterField(s, "description") || "Operate the Ralph harness";
      const body = stripFrontmatter(s).replace(/\$ARGUMENTS/g, "${input:args}");
      return `---\ndescription: ${desc}\nmode: agent\n---\n\n${body}`;
    };

    const AGENT_TARGETS = {
      claude: {
        label: "Claude Code",
        dir: () => path.join(home, ".claude", "commands"),
        ext: ".md",
        transform: (s) => s, // canonical format
        invoke: "in Claude Code, type /ralph-review, /ralph-status, …",
      },
      codex: {
        label: "Codex CLI",
        dir: () => path.join(home, ".codex", "prompts"),
        ext: ".md",
        transform: stripFrontmatter, // Codex prompts are plain markdown; $ARGUMENTS works
        invoke: "in Codex, type /ralph-review, /ralph-status, …",
      },
      copilot: {
        label: "GitHub Copilot (VS Code, user prompts)",
        dir: copilotUserPromptsDir,
        ext: ".prompt.md",
        transform: toCopilotPrompt, // .prompt.md + ${input:args}
        invoke: "in Copilot Chat (VS Code), type /ralph-review, /ralph-status, …",
      },
    };

    const order = ["claude", "codex", "copilot"];
    const valid = order;
    let targetChoice = agentOverride || null;
    if (!targetChoice) {
      if (process.stdout.isTTY && process.stdin.isTTY) {
        const { intro, outro, select, isCancel } = await loadPrompts();
        intro("Ralph: install agent commands");
        const sel = await select({
          message: "Install operator commands for which agent?",
          options: order.map((k) => ({ value: k, label: AGENT_TARGETS[k].label })),
          initialValue: order[0],
        });
        if (isCancel(sel)) {
          outro("Cancelled.");
          process.exit(0);
        }
        targetChoice = sel;
        outro("Installing...");
      } else {
        targetChoice = order[0]; // non-interactive default
      }
    }
    if (!valid.includes(targetChoice)) {
      console.error(`install-agent-commands supports: ${valid.join(", ")} (got "${targetChoice}").`);
      process.exit(1);
    }

    const target = AGENT_TARGETS[targetChoice];
    const srcDir = path.join(repoRoot, "agent-commands", "ralph");
    if (!exists(srcDir)) {
      console.error(`Command templates not found at ${srcDir}`);
      process.exit(1);
    }
    const destDir = target.dir();
    fs.mkdirSync(destDir, { recursive: true });
    const files = fs.readdirSync(srcDir).filter((f) => f.endsWith(".md"));
    // These are harness-managed command files, so re-running UPDATES them by
    // default (content-aware: unchanged files are left untouched). That means
    // `install-agent-commands` is how you push command updates to your agents.
    const installed = [];
    const updated = [];
    const unchanged = [];
    for (const f of files) {
      const base = `ralph-${f.replace(/\.md$/, "")}`; // review.md -> ralph-review
      const dst = path.join(destDir, base + target.ext);
      const content = target.transform(fs.readFileSync(path.join(srcDir, f), "utf-8"));
      const existed = exists(dst);
      const same = existed && fs.readFileSync(dst, "utf-8") === content;
      if (same) {
        unchanged.push(base);
        continue;
      }
      fs.writeFileSync(dst, content);
      (existed ? updated : installed).push(base);
    }
    console.log(`Target agent: ${target.label}`);
    console.log(`Source:       ${srcDir}`);
    console.log(`Installed to: ${destDir}`);
    if (installed.length) console.log(`Installed:    ${installed.map((b) => "/" + b).join(", ")}`);
    if (updated.length) console.log(`Updated:      ${updated.map((b) => "/" + b).join(", ")}`);
    if (unchanged.length) console.log(`Unchanged:    ${unchanged.map((b) => "/" + b).join(", ")}`);
    console.log(`\nUse them: ${target.invoke}`);
    process.exit(0);
  }

  // --- Scaffold a target repo for the harness ---------------------------------
  if (cmd === "init-target") {
    const targetRepo = review.repo || process.env.TARGET_REPO;
    if (!targetRepo) {
      console.error("ralph init-target requires --repo <path>");
      process.exit(1);
    }
    const repo = path.resolve(cwd, targetRepo);
    if (!exists(repo)) {
      console.error(`Target repo not found: ${repo}`);
      process.exit(1);
    }
    const type = review.type || "generic";
    if (!["generic", "nextjs-postgres"].includes(type)) {
      console.error(`Unknown --type "${type}" (use generic|nextjs-postgres)`);
      process.exit(1);
    }
    const templateDir = exists(localDir) ? localDir : globalDir;
    const tplDir = path.join(templateDir, "target-templates");
    const created = [];
    const updated = [];
    const skipped = [];

    const tasksDir = path.join(repo, ".agents", "tasks");
    if (!exists(tasksDir)) {
      fs.mkdirSync(tasksDir, { recursive: true });
      created.push(".agents/tasks/");
    }

    const giPath = path.join(repo, ".gitignore");
    let gi = exists(giPath) ? fs.readFileSync(giPath, "utf-8") : "";
    let giChanged = false;
    for (const entry of [".ralph/", ".agent-run/", ".agent-handoff.md"]) {
      const present = gi.split("\n").some((l) => l.trim() === entry);
      if (!present) {
        gi += (gi && !gi.endsWith("\n") ? "\n" : "") + entry + "\n";
        giChanged = true;
      }
    }
    if (giChanged) {
      fs.writeFileSync(giPath, gi);
      updated.push(".gitignore");
    }

    const scriptsDir = path.join(repo, "scripts");
    fs.mkdirSync(scriptsDir, { recursive: true });
    const copyScript = (name) => {
      const dst = path.join(scriptsDir, name);
      if (exists(dst) && !installForce) {
        skipped.push(`scripts/${name}`);
        return;
      }
      const src = path.join(tplDir, name);
      if (!exists(src)) {
        skipped.push(`scripts/${name} (no template)`);
        return;
      }
      fs.copyFileSync(src, dst);
      fs.chmodSync(dst, 0o755);
      created.push(`scripts/${name}`);
    };
    copyScript("check.sh");

    let cfgObj;
    if (type === "nextjs-postgres") {
      for (const s of ["preview-up.sh", "preview-down.sh", "preview-url.sh", "e2e.sh"])
        copyScript(s);
      cfgObj = {
        check: "./scripts/check.sh",
        // Repo-contract preflight: run before any worktree/agent; blocks on failure.
        preflight: {
          enabled: true,
          install: "npm ci",
          check: "./scripts/check.sh",
          test: "npm test",
          e2e: "",
        },
        preview: {
          enabled: true,
          up: "./scripts/preview-up.sh",
          down: "./scripts/preview-down.sh",
          url: "./scripts/preview-url.sh",
          e2e: "./scripts/e2e.sh",
          host: "localhost",
          keepOnPass: true,
          keepOnFail: false,
        },
      };
    } else {
      cfgObj = {
        check: "./scripts/check.sh",
        preflight: { enabled: true, check: "./scripts/check.sh" },
        preview: { enabled: false },
      };
    }
    const cfgPath = path.join(repo, "ralph.target.json");
    if (exists(cfgPath) && !installForce) {
      skipped.push("ralph.target.json");
    } else {
      fs.writeFileSync(cfgPath, JSON.stringify(cfgObj, null, 2) + "\n");
      created.push("ralph.target.json");
    }

    console.log(`Initialized target (${type}): ${repo}`);
    if (created.length) console.log(`Created: ${created.join(", ")}`);
    if (updated.length) console.log(`Updated: ${updated.join(", ")}`);
    if (skipped.length) console.log(`Skipped (exist; use --force): ${skipped.join(", ")}`);
    console.log(
      `\nNext: add a PRD JSON under .agents/tasks/, edit scripts/, then run:\n  ralph review 1 --repo ${repo}`,
    );
    process.exit(0);
  }

  // --- Status of the latest (or chosen) run -----------------------------------
  if (cmd === "status") {
    const targetRepo = review.repo || process.env.TARGET_REPO;
    if (!targetRepo) {
      console.error("ralph status requires --repo <path>");
      process.exit(1);
    }
    const repo = path.resolve(cwd, targetRepo);
    const { runId, runDir, meta } = loadRunMeta(repo, review.run);
    if (!runId) {
      console.log(`No Ralph runs found in ${path.join(repo, ".ralph", "runs")}.`);
      process.exit(0);
    }
    console.log(`Ralph status for ${repo}`);
    console.log(`- Run:       ${meta.RUN_ID || runId}`);
    console.log(`- Status:    ${meta.STATUS || "unknown"}`);
    console.log(`- Branch:    ${meta.BRANCH || "?"}`);
    console.log(`- Worktree:  ${meta.WORKTREE || "?"}`);
    console.log(`- Base:      ${meta.BASE_COMMIT || meta.BASE_REF || "?"}`);
    if (meta.PREVIEW_URL) console.log(`- Preview:   ${meta.PREVIEW_URL}`);
    console.log(`- Artifacts: ${meta.ARTIFACTS_DIR || runDir}`);
    const base = meta.BASE_COMMIT || meta.BASE_REF;
    if (meta.BRANCH && base) {
      const wt = meta.WORKTREE && exists(meta.WORKTREE) ? meta.WORKTREE : repo;
      const stat = git(wt, ["diff", "--stat", base]);
      if (stat.status === 0 && stat.stdout.trim()) {
        console.log(`\nDiff summary (vs base):\n${stat.stdout.trim()}`);
      }
    }
    if ((meta.STATUS || "") === "READY_FOR_HUMAN_REVIEW") {
      console.log(`\nREADY_FOR_HUMAN_REVIEW — after you approve:`);
      console.log(`  ralph integrate --repo ${repo} --run ${meta.RUN_ID || runId}`);
    }
    process.exit(0);
  }

  // --- Integrate an approved run ----------------------------------------------
  if (cmd === "integrate") {
    const targetRepo = review.repo || process.env.TARGET_REPO;
    if (!targetRepo) {
      console.error("ralph integrate requires --repo <path>");
      process.exit(1);
    }
    const repo = path.resolve(cwd, targetRepo);
    const { runId, meta } = loadRunMeta(repo, review.run);
    if (!runId) {
      console.error("No run found to integrate.");
      process.exit(1);
    }
    const status = meta.STATUS || "";
    if (status !== "READY_FOR_HUMAN_REVIEW" && !installForce) {
      console.error(
        `Run ${runId} status is "${status || "unknown"}", not READY_FOR_HUMAN_REVIEW. Use --force to override.`,
      );
      process.exit(1);
    }
    const branch = meta.BRANCH;
    if (!branch) {
      console.error("No branch recorded for this run.");
      process.exit(1);
    }
    const dirty = git(repo, ["status", "--porcelain"])
      .stdout.split("\n")
      .filter((l) => l && !/\.ralph\//.test(l));
    if (dirty.length) {
      console.error(`Target repo has uncommitted changes; commit/stash first:\n${dirty.join("\n")}`);
      process.exit(1);
    }
    const curBranch = git(repo, ["rev-parse", "--abbrev-ref", "HEAD"]).stdout.trim();
    console.log(`Integrating run ${runId}`);
    console.log(`- Merge branch:   ${branch}`);
    console.log(`- Into:           ${curBranch}`);
    const base = meta.BASE_COMMIT || meta.BASE_REF;
    const stat = git(repo, ["diff", "--stat", base ? `${base}..${branch}` : `${curBranch}..${branch}`]);
    if (stat.stdout.trim()) console.log(`\nDiff summary:\n${stat.stdout.trim()}\n`);
    const merge = git(
      repo,
      ["merge", "--no-ff", branch, "-m", `ralph integrate ${runId} (${branch})`],
      { stdio: "inherit", encoding: undefined },
    );
    if (merge.status !== 0) {
      console.error("Merge failed (resolve conflicts manually). Nothing was pushed.");
      process.exit(merge.status ?? 1);
    }
    console.log("Merge complete (not pushed).");
    const cfg = readTargetConfig(repo);
    const checkCmd = review.check || cfg.check || "./scripts/check.sh";
    console.log(`\nRe-running check after merge: ${checkCmd}`);
    const chk = spawnSync("bash", ["-lc", checkCmd], { cwd: repo, stdio: "inherit" });

    // SAFETY: a failed post-merge check skips cleanup so the worktree/preview
    // stay available for debugging. (A failed merge already exited above.)
    if (chk.status !== 0) {
      console.error(
        `\n⚠️  Post-merge check FAILED (exit ${chk.status}). The merge is in your working tree but NOT pushed.`,
      );
      console.log(
        `\nSkipping cleanup so you can debug. Worktree and preview left in place. When ready:\n  ralph cleanup --repo ${repo} --run ${runId}`,
      );
      console.log(`Nothing pushed. Push when ready: git -C ${repo} push`);
      process.exit(2);
    }

    console.log("\n✅ Post-merge check passed.");
    if (cfg.preview && cfg.preview.enabled) {
      console.log(
        `\nNote: preview/e2e were validated on branch ${branch} during the run. They are NOT re-run on integrate by default; re-run \`ralph review\` or your preview scripts to validate the merged result.`,
      );
    }
    console.log(`\nNothing pushed. Push when ready: git -C ${repo} push`);

    // DEFAULT: clean up this run (stop preview + remove worktree), keeping the
    // branch. Opt out with --keep-worktree / --skip-cleanup.
    if (review.skipCleanup) {
      console.log(
        `\nCleanup skipped (--keep-worktree). Clean up when done:\n  ralph cleanup --repo ${repo} --run ${runId}`,
      );
    } else {
      console.log("\nCleaning up this run (default after a successful integrate):");
      // Never delete the branch as part of the integrate default; only --delete-branch does.
      doCleanup(repo, runId, meta, review.deleteBranch, installForce);
      if (!review.deleteBranch && branch) {
        console.log(
          `\nBranch ${branch} kept. Delete it yourself when no longer needed:\n  git -C ${repo} branch -D ${branch}`,
        );
      }
    }
    process.exit(0);
  }

  // --- Cleanup a run (worktree + preview) -------------------------------------
  if (cmd === "cleanup") {
    const targetRepo = review.repo || process.env.TARGET_REPO;
    if (!targetRepo) {
      console.error("ralph cleanup requires --repo <path>");
      process.exit(1);
    }
    const repo = path.resolve(cwd, targetRepo);
    const { runId, meta } = loadRunMeta(repo, review.run);
    if (!runId) {
      console.error("No run found to clean up.");
      process.exit(1);
    }
    const code = doCleanup(repo, runId, meta, review.deleteBranch, installForce);
    process.exit(code);
  }

  if (cmd === "install") {
    if (exists(localDir) && !installForce) {
      console.log(`.agents/ralph already exists at ${localDir}. Skipping templates.`);
    } else {
      if (!exists(globalDir)) {
        console.error(`Bundled templates not found at ${globalDir}.`);
        process.exit(1);
      }
      fs.mkdirSync(path.dirname(localDir), { recursive: true });
      fs.cpSync(globalDir, localDir, { recursive: true, force: true });
      console.log(`Installed .agents/ralph to ${localDir}`);
    }
    const readmeSrc = path.join(repoRoot, "README.md");
    const diagramSrc = path.join(repoRoot, "diagram.svg");
    const imageSrc = path.join(repoRoot, "ralph.webp");
    if (exists(localDir)) {
      const readmeDst = path.join(localDir, "README.md");
      const diagramDst = path.join(localDir, "diagram.svg");
      const imageDst = path.join(localDir, "ralph.webp");
      if (exists(readmeSrc)) fs.copyFileSync(readmeSrc, readmeDst);
      if (exists(diagramSrc)) fs.copyFileSync(diagramSrc, diagramDst);
      if (exists(imageSrc)) fs.copyFileSync(imageSrc, imageDst);
    }
    if (installSkills) {
      await runInstallSkills();
    } else {
      const { confirm, isCancel } = await loadPrompts();
      const wantsSkills = await confirm({
        message: "Install skills (commit + dev-browser + prd)?",
        initialValue: true,
      });
      if (isCancel(wantsSkills)) {
        console.log("Skipped skills install.");
      } else if (wantsSkills) {
        await runInstallSkills();
      }
    }
    process.exit(0);
  }

  const templateDir = exists(localDir) ? localDir : globalDir;
  if (!exists(templateDir)) {
    console.error("No .agents/ralph found locally and no bundled defaults available.");
    process.exit(1);
  }
  if (templateDir === localDir) {
    console.log(`Using local templates: ${localDir}`);
  } else {
    console.log(`Using bundled templates: ${globalDir}`);
  }

  const loopPath = path.join(templateDir, "loop.sh");
  if (!exists(loopPath)) {
    console.error(`loop.sh not found at ${loopPath}`);
    process.exit(1);
  }

  const loopArgs = args.length ? args : ["build"];
  const loadAgentMap = () => {
    const defaults = {
      codex: "codex exec --yolo --skip-git-repo-check -",
      claude: "claude -p --dangerously-skip-permissions \"$(cat {prompt})\"",
      droid: "droid exec --skip-permissions-unsafe -f {prompt}",
      opencode: "opencode run \"$(cat {prompt})\"",
    };
    const interactiveDefaults = {
      codex: "codex --yolo {prompt}",
      claude: "claude --dangerously-skip-permissions {prompt}",
      droid: "droid --skip-permissions-unsafe {prompt}",
      opencode: "opencode --prompt {prompt}",
    };
    const agentsPath = path.join(templateDir, "agents.sh");
    if (!exists(agentsPath)) {
      return {
        headless: defaults,
        interactive: interactiveDefaults,
        defaultAgent: "codex",
      };
    }
    const safePath = agentsPath.replace(/'/g, "'\\''");
    const bashCmd = [
      `source '${safePath}'`,
      'printf "DEFAULT_AGENT=%s\\n" "${DEFAULT_AGENT:-}"',
      'printf "AGENT_CODEX_CMD=%s\\n" "${AGENT_CODEX_CMD:-}"',
      'printf "AGENT_CLAUDE_CMD=%s\\n" "${AGENT_CLAUDE_CMD:-}"',
      'printf "AGENT_DROID_CMD=%s\\n" "${AGENT_DROID_CMD:-}"',
      'printf "AGENT_OPENCODE_CMD=%s\\n" "${AGENT_OPENCODE_CMD:-}"',
      'printf "AGENT_CODEX_INTERACTIVE_CMD=%s\\n" "${AGENT_CODEX_INTERACTIVE_CMD:-}"',
      'printf "AGENT_CLAUDE_INTERACTIVE_CMD=%s\\n" "${AGENT_CLAUDE_INTERACTIVE_CMD:-}"',
      'printf "AGENT_DROID_INTERACTIVE_CMD=%s\\n" "${AGENT_DROID_INTERACTIVE_CMD:-}"',
      'printf "AGENT_OPENCODE_INTERACTIVE_CMD=%s\\n" "${AGENT_OPENCODE_INTERACTIVE_CMD:-}"',
    ].join("; ");
    const result = spawnSync("bash", ["-lc", bashCmd], { encoding: "utf-8" });
    if (result.status !== 0) {
      return {
        headless: defaults,
        interactive: interactiveDefaults,
        defaultAgent: "codex",
      };
    }
    const parsed = new Map();
    for (const line of String(result.stdout || "").split("\n")) {
      if (!line) continue;
      const idx = line.indexOf("=");
      if (idx === -1) continue;
      parsed.set(line.slice(0, idx), line.slice(idx + 1));
    }
    const readVar = (name) => parsed.get(name) || null;
    return {
      headless: {
        codex: readVar("AGENT_CODEX_CMD") || defaults.codex,
        claude: readVar("AGENT_CLAUDE_CMD") || defaults.claude,
        droid: readVar("AGENT_DROID_CMD") || defaults.droid,
        opencode: readVar("AGENT_OPENCODE_CMD") || defaults.opencode,
      },
      interactive: {
        codex: readVar("AGENT_CODEX_INTERACTIVE_CMD") || interactiveDefaults.codex,
        claude: readVar("AGENT_CLAUDE_INTERACTIVE_CMD") || interactiveDefaults.claude,
        droid: readVar("AGENT_DROID_INTERACTIVE_CMD") || interactiveDefaults.droid,
        opencode: readVar("AGENT_OPENCODE_INTERACTIVE_CMD") || interactiveDefaults.opencode,
      },
      defaultAgent: readVar("DEFAULT_AGENT") || "codex",
    };
  };
  const agentDefs = loadAgentMap();
  const agentMap = agentDefs.headless;
  const agentInteractiveMap = agentDefs.interactive;
  const defaultAgent = agentDefs.defaultAgent || "codex";
  if (agentOverride) {
    const mapped = agentMap[agentOverride];
    if (!mapped) {
      console.error(`Unknown agent: ${agentOverride}`);
      console.error("Valid values: codex, claude, droid, opencode");
      process.exit(1);
    }
    process.env.AGENT_CMD = mapped;
  }
  const env = { ...process.env, RALPH_ROOT: cwd };
  if (!env.ACTIVITY_CMD) {
    env.ACTIVITY_CMD = "ralph log";
  }
  if (progressPath) env.PROGRESS_PATH = progressPath;
  if (templateDir === globalDir) {
    env.PROMPT_BUILD = path.join(templateDir, "PROMPT_build.md");
    env.GUARDRAILS_REF = path.join(templateDir, "references", "GUARDRAILS.md");
    env.CONTEXT_REF = path.join(templateDir, "references", "CONTEXT_ENGINEERING.md");
  }

  if (cmd === "ping") {
    const agentName = agentOverride || defaultAgent;
    const agentCmd = agentMap[agentName];
    if (!agentCmd) {
      console.error("Unknown agent for ping.");
      process.exit(1);
    }
    const agentBin = agentCmd.split(" ")[0];
    const existsResult = spawnSync(`command -v ${agentBin}`, { shell: true, stdio: "ignore" });
    if (existsResult.status !== 0) {
      console.error(`Agent command not found: ${agentBin}`);
      process.exit(1);
    }
    const promptFile = path.join(os.tmpdir(), `ralph-ping-${Date.now()}.txt`);
    fs.writeFileSync(promptFile, "Reply with <end>pong</end> only.");
    const escapePath = (value) => `'${String(value).replace(/'/g, "'\\''")}'`;
    const rendered = agentCmd.includes("{prompt}")
      ? agentCmd.replace(/\{prompt\}/g, escapePath(promptFile))
      : `cat ${escapePath(promptFile)} | ${agentCmd}`;
    const result = spawnSync(rendered, { shell: true, encoding: "utf-8" });
    const output = `${result.stdout || ""}${result.stderr || ""}`;
    if (!output.includes("<end>pong</end>")) {
      console.error("Ping failed: missing <end>pong</end>.");
      process.exit(1);
    }
    console.log("Ping OK.");
    process.exit(0);
  }

  if (cmd === "plan") {
    console.error("The plan command has been removed. Use `ralph build` with a JSON PRD.");
    process.exit(1);
  }

  if (cmd === "log") {
    const message = args.slice(1).join(" ").trim();
    if (!message) {
      console.error('Usage: ralph log "message"');
      process.exit(1);
    }
    const activityLog = path.join(cwd, ".ralph", "activity.log");
    fs.mkdirSync(path.dirname(activityLog), { recursive: true });
    const now = new Date();
    const pad = (n) => String(n).padStart(2, "0");
    const stamp = `${now.getFullYear()}-${pad(now.getMonth() + 1)}-${pad(now.getDate())} ${pad(now.getHours())}:${pad(now.getMinutes())}:${pad(now.getSeconds())}`;
    fs.appendFileSync(activityLog, `[${stamp}] ${message}\n`);
    process.exit(0);
  }

  if (cmd === "prd") {
    let request = args.slice(1).join(" ").trim();
    if (!request) {
      const { intro, outro, text, isCancel } = await loadPrompts();
      intro("Ralph PRD");
      const response = await text({
        message: "Describe the feature you want a PRD for",
        placeholder: "Example: A lightweight uptime monitor with email alerts",
      });
      if (isCancel(response)) {
        outro("Cancelled.");
        process.exit(0);
      }
      request = String(response || "").trim();
      if (!request) {
        outro("No description provided.");
        process.exit(1);
      }
      outro("Generating PRD...");
    }
    const requestFile = path.join(os.tmpdir(), `ralph-prd-${Date.now()}.md`);
    fs.writeFileSync(requestFile, `${request}\n`);
    const outputPath = prdOutPath || prdPath || defaultPrdOutputPath(cwd, request);
    env.PRD_PATH = outputPath;
    const agentName = agentOverride || defaultAgent;
    const prdAgent = agentInteractiveMap[agentName] || agentMap[agentName];
    if (prdAgent) {
      env.PRD_AGENT_CMD = prdAgent;
    }
    const prdArgs = ["prd", "--prompt", requestFile];
    const result = spawnSync(loopPath, prdArgs, {
      stdio: "inherit",
      env,
    });
    process.exit(result.status ?? 1);
  }

  if (cmd === "overview") {
    const resolvedPrdPath = await resolvePrdPath({
      cwd,
      explicitPath: prdPath,
      label: "Ralph overview",
    });
    if (!resolvedPrdPath) {
      console.error("No PRD JSON files found. Run `ralph prd` first.");
      process.exit(1);
    }
    const prdText = fs.readFileSync(resolvedPrdPath, "utf-8");
    let prd;
    try {
      prd = JSON.parse(prdText);
    } catch (err) {
      const message = err instanceof Error ? err.message : String(err);
      console.error(`Invalid PRD JSON: ${message}`);
      process.exit(1);
    }
    const stories = Array.isArray(prd.stories) ? prd.stories : [];
    const total = stories.length;
    const done = stories.filter((s) => String(s.status || "open").toLowerCase() === "done").length;
    const inProgress = stories.filter((s) => String(s.status || "open").toLowerCase() === "in_progress").length;
    const open = total - done - inProgress;
    const gates = Array.isArray(prd.qualityGates) ? prd.qualityGates : [];
    const parsed = path.parse(resolvedPrdPath);
    const overviewPath = path.join(parsed.dir, `${parsed.name}.overview.md`);

    const lines = [];
    lines.push(`# PRD Overview${prd.project ? `: ${prd.project}` : ""}`);
    lines.push("");
    lines.push(`- File: ${path.relative(cwd, resolvedPrdPath)}`);
    lines.push(`- Stories: ${total} total (${open} open, ${inProgress} in_progress, ${done} done)`);
    lines.push("");
    lines.push("## Quality Gates");
    if (gates.length === 0) {
      lines.push("- (none)");
    } else {
      for (const gate of gates) lines.push(`- ${gate}`);
    }
    lines.push("");
    lines.push("## Stories");
    if (total === 0) {
      lines.push("- (none)");
    } else {
      for (const story of stories) {
        const status = String(story.status || "open").toLowerCase();
        const depends = Array.isArray(story.dependsOn) && story.dependsOn.length
          ? ` (depends on: ${story.dependsOn.join(", ")})`
          : "";
        lines.push(`- [${status}] ${story.id || "US-???"}: ${story.title || ""}${depends}`);
      }
    }
    fs.writeFileSync(overviewPath, `${lines.join("\n")}\n`);
    console.log(`Overview written to ${path.relative(cwd, overviewPath)}`);
    process.exit(0);
  }

  const needsPrd = cmd === "build" || !cmd;
  if (needsPrd) {
    const resolvedPrdPath = await resolvePrdPath({
      cwd,
      explicitPath: prdPath,
      label: "Ralph build",
    });
    if (!resolvedPrdPath) {
      console.error("No PRD JSON files found. Run `ralph prd` first.");
      process.exit(1);
    }
    env.PRD_PATH = resolvedPrdPath;
  }

  // Preflight (repo contract) before the single-agent build loop. No-op unless a
  // `preflight` block is configured in ./ralph.target.json. Blocks on failure.
  if (needsPrd && env.RALPH_DRY_RUN !== "1") {
    const pf = path.join(templateDir, "preflight.sh");
    if (exists(pf)) {
      const pfEnv = { ...env };
      if (review.skipPreflight) pfEnv.PREFLIGHT_SKIP = "true";
      const report = path.join(cwd, ".ralph", "preflight.md");
      const pfRes = spawnSync("bash", [pf, cwd, report], { stdio: "inherit", env: pfEnv });
      if (pfRes.status === 3) {
        console.error("Preflight failed — repo baseline is not healthy. Not starting the build.");
        console.error(`See ${report} and fix the repo contract first (or pass --no-preflight).`);
        process.exit(3);
      }
    }
  }

  const result = spawnSync(loopPath, loopArgs, {
    stdio: "inherit",
    env,
  });

  process.exit(result.status ?? 1);
}

main().catch((err) => {
  console.error(err);
  process.exit(1);
});
