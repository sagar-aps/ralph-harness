{
  "_note": "Ralph efficiency profile — the OPERATOR policy for which rung (builder/reviewer pairing) each complexity tier may use, and when a credential pool stops being eligible. Copy to .agents/ralph/efficiency.json (gitignored, like config.local.sh) and edit. As of #61 this profile drives SELECTION (`ralph explain` / ralph_efficiency_select report the rung it would pick, enforcing the caps, avoid windows, the hard quota circuit and the reserves) but it still DISPATCHES NOTHING: --builder/--reviewer decide who actually runs. Wiring the recommendation into dispatch is a later slice (#54 step 4d).",
  "_schema": {
    "rungs": "ladder, CHEAPEST FIRST. Each rung names the backend + credential pool for each role. `pool` is the credential pool (same concept as RALPH_BUILDER_CREDENTIAL_POOL / RALPH_REVIEWER_CREDENTIAL_POOL): several backends can share one plan's quota.",
    "caps": "keyed by pool. Three shapes: {window_5h_pct, window_weekly_pct} = stop using the pool once that share of the rolling window is spent; {source: \"provider\"} = the provider meters it, the harness applies no local cap; {backstop: true} = uncapped last resort.",
    "caps_optional": "any cap block may ALSO carry (#60): window_5h_budget_tokens / window_weekly_budget_tokens = the pool's token budget for that window, which is the ONLY thing that turns the ledger's token sums into a percentage (without it `ralph explain` reports raw tokens and pct=unknown — it never invents a percentage); weekly_reset_anchor = an ISO-8601 UTC instant the weekly window repeats from (e.g. \"2026-08-05T09:00:00Z\"), which is what makes the weekly window and its reset time knowable instead of a rolling 7 days. These are LOCAL estimates from .ralph/ledger.jsonl — no provider usage API is called.",
    "avoid_windows": "per rung. from/to are HH:MM in tz (UTC only), days like \"Mon-Fri\" / \"Sat,Sun\" / \"*\". While the current UTC time is inside the window the rung is not eligible.",
    "reserves": "<pool>_weekly_pct = keep at least this much of the pool's weekly window unspent for higher-value work. near_weekly_reset_hours = relax the reserve (and the weekly cap) when the weekly window resets within this many hours (unspent quota is about to expire anyway). ENFORCEMENT IS IN CODE (#61): these are the numbers, not the switch — omitting anthropic_weekly_pct / zai_weekly_pct does NOT disable those reserves, it falls back to the built-in 25 / 55 (and 5 hours).",
    "tiers": "which rungs each task complexity may use, in preference order."
  },
  "rungs": [
    {
      "name": "zlaude",
      "builder": { "backend": "zlaude", "pool": "zai" },
      "reviewer": { "backend": "zlaude", "pool": "zai" },
      "caps": {
        "zai": { "window_5h_pct": 70, "window_weekly_pct": 45 }
      },
      "avoid_windows": [
        {
          "from": "06:00",
          "to": "10:00",
          "tz": "UTC",
          "days": "Mon-Fri",
          "reason": "3x quota burn (Z.AI peak)"
        }
      ]
    },
    {
      "name": "codex",
      "builder": { "backend": "codex", "pool": "openai" },
      "reviewer": { "backend": "codex-readonly", "pool": "openai" },
      "caps": {
        "openai": { "source": "provider" }
      }
    },
    {
      "name": "claude",
      "builder": { "backend": "claude", "pool": "anthropic" },
      "reviewer": { "backend": "claude", "pool": "anthropic" },
      "caps": {
        "anthropic": { "window_5h_pct": 80, "window_weekly_pct": 75 }
      }
    },
    {
      "name": "deepseek",
      "builder": { "backend": "dlaude", "pool": "deepseek" },
      "reviewer": { "backend": "dlaude", "pool": "deepseek" },
      "caps": {
        "deepseek": { "backstop": true }
      }
    }
  ],
  "reserves": {
    "anthropic_weekly_pct": 25,
    "zai_weekly_pct": 55,
    "near_weekly_reset_hours": 5
  },
  "tiers": {
    "trivial": ["deepseek", "zlaude"],
    "small": ["zlaude", "codex"],
    "medium": ["codex", "claude", "deepseek"],
    "large": ["claude", "deepseek"]
  }
}
